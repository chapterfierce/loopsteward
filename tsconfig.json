{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/m3-integration-test.ts",
    "src/magpie/**/*",
    "src/loops/**/*",
    "src/mcp/**/*",
    "src/observability/**/*",
    "src/task-manager/**/*",
    "intent-engine/**/*",
    "tests/m4-integration-test.ts",
    "tests/magpie-format.test.ts",
    "tests/magpie-source.test.ts",
    "tests/loop-store.test.ts",
    "tests/session-source.test.ts",
    "tests/loop-extractor.test.ts",
    "tests/loop-ingest.test.ts",
    "tests/loop-digest.test.ts",
    "tests/loop-projects.test.ts",
    "tests/loop-audit.test.ts",
    "tests/loop-stats.test.ts",
    "tests/loop-feedback.test.ts",
    "tests/loop-feedback-cli.test.ts",
    "tests/loop-coverage.test.ts",
    "tests/loop-skill-install.test.ts",
    "tests/session-policy.test.ts",
    "tests/loop-setup.test.ts",
    "tests/loop-calibrate.test.ts",
    "tests/data-path.test.ts",
    "tests/refresh-script.test.ts",
    "tests/loop-reconcile.test.ts",
    "tests/mcp-install.test.ts",
    "tests/mcp-server.test.ts",
    "tests/project-map.test.ts",
    "tests/m10-integration-test.ts",
    "tests/m11-circuit-breaker-test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "intent-engine/__tests__",
    "src/quantization"
  ]
}
