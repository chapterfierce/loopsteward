# 本地开发配置：复制为 .env.local 后填写，不要把真实密钥提交进仓库。
# 发布包不带任何默认地址或模型；运行时只读环境变量或 ~/.loopsteward/config.json。
LOOPSTEWARD_BASE_URL=https://your-gateway.example/v1
LOOPSTEWARD_MODEL=your-model
LOOPSTEWARD_API_KEY=

# 可选：指定本地配置文件路径（默认 ~/.loopsteward/config.json）
# LOOPSTEWARD_CONFIG=

# 兼容旧名称（可选）
# MAGPIE_BASE_URL=
# MAGPIE_MODEL=
# MAGPIE_API_KEY=
